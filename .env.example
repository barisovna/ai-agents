# LLM провайдер (обязательно)
# Получить на: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Веб-поиск (опционально — без него агенты работают без актуальных данных)
# Получить на: https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-key-here

# Защита API endpoint (опционально, но рекомендуется)
# Придумай любую случайную строку, например: openssl rand -base64 32
# Оба значения должны быть ОДИНАКОВЫМИ
CHAT_API_KEY=your-random-secret-here
NEXT_PUBLIC_CHAT_API_KEY=your-random-secret-here
